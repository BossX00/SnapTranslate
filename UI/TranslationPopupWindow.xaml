<Window x:Class="SnapTranslate.UI.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        MaxHeight="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35" />
            <Setter Property="Foreground" Value="#E4E4EC" />
            <Setter Property="BorderBrush" Value="#3E3E4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI, Leelawadee UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#48485C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="12"
            Background="#F71C1C24"
            BorderBrush="#3C3C4E"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="DirectionBadge"
                            Background="#2563EB"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="DirectionText"
                                   Text="TH → EN"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="11.5"
                                   FontWeight="Bold" />
                    </Border>
                    <Button x:Name="SwapButton"
                            Content="⇄"
                            ToolTip="สลับภาษาปลายทาง"
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="6,0,0,0"
                            Padding="7,3"
                            FontSize="13"
                            Click="SwapButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReplaceButton"
                            Content="แทนที่"
                            ToolTip="วางคำแปลแทนที่ข้อความที่เลือก"
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="0,0,6,0"
                            Click="ReplaceButton_Click" />
                    <Button x:Name="CopyButton"
                            Content="คัดลอก"
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="0,0,6,0"
                            Click="CopyButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="✕"
                            ToolTip="ปิด (Esc)"
                            Style="{StaticResource HeaderButtonStyle}"
                            Padding="7,4"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>

            <!-- Body -->
            <Grid Grid.Row="1">
                <StackPanel x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            Margin="2,10,2,12"
                            Visibility="Visible">
                    <Ellipse Width="9" Height="9" Fill="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="กำลังแปลภาษา..."
                               Foreground="#A1A1B5"
                               FontFamily="Segoe UI, Leelawadee UI"
                               FontSize="13.5"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBox x:Name="ResultTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#F4F4F8"
                         SelectionBrush="#3B82F6"
                         FontFamily="Segoe UI, Leelawadee UI"
                         FontSize="14.5"
                         TextWrapping="Wrap"
                         MaxHeight="250"
                         VerticalScrollBarVisibility="Auto"
                         Padding="0"
                         Visibility="Collapsed" />

                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#FCA5A5"
                           FontFamily="Segoe UI, Leelawadee UI"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,4,0,6"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="0,8,0,0"
                    BorderBrush="#2C2C3A"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="SourcePreviewText"
                           Foreground="#8A8AA0"
                           FontFamily="Segoe UI, Leelawadee UI"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           Text="ต้นฉบับ: " />
            </Border>
        </Grid>
    </Border>
</Window>
